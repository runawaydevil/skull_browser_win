<Window x:Class="SkullWins.Spike.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Skull Wins :: spike de teclado"
        Height="820" Width="1180"
        Background="#0d0d0d">

    <DockPanel LastChildFill="True">

        <!-- barra de comando: so aparece no modo command -->
        <TextBox x:Name="CmdBox"
                 DockPanel.Dock="Bottom"
                 Visibility="Collapsed"
                 Background="#0d0d0d" Foreground="#e8e8e8"
                 CaretBrush="#e8e8e8"
                 BorderThickness="0" Padding="6,4"
                 FontFamily="Consolas" FontSize="13" />

        <!-- statusbar -->
        <Grid DockPanel.Dock="Bottom" Background="#1a1a1a">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLeft" Grid.Column="0"
                       Foreground="#9fd18a" Padding="6,3"
                       FontFamily="Consolas" FontSize="12" Text="-- NORMAL --" />
            <TextBlock x:Name="StatusRight" Grid.Column="1"
                       Foreground="#7a7a7a" Padding="6,3"
                       FontFamily="Consolas" FontSize="12" Text="" />
        </Grid>

        <wv2:WebView2 x:Name="Web" />

    </DockPanel>
</Window>
