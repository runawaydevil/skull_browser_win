<Window x:Class="SkullWins.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skull Wins" Height="860" Width="1280"
        Background="#0d0d0d" UseLayoutRounding="True">

    <DockPanel LastChildFill="True">

        <!-- tab strip -->
        <ItemsControl x:Name="TabStrip" DockPanel.Dock="Top" Background="#161616">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- command bar, visible only in command mode -->
        <TextBox x:Name="CmdBox" DockPanel.Dock="Bottom" Visibility="Collapsed"
                 Background="#0d0d0d" Foreground="#e8e8e8" CaretBrush="#9fd18a"
                 BorderThickness="0" Padding="7,5"
                 FontFamily="Consolas" FontSize="13" />

        <!-- status bar -->
        <Grid DockPanel.Dock="Bottom" Background="#161616">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusMode" Grid.Column="0" Foreground="#9fd18a"
                       Padding="7,3,4,3" FontFamily="Consolas" FontSize="12" />
            <TextBlock x:Name="StatusUri" Grid.Column="1" Foreground="#b8b8b8"
                       Padding="0,3" FontFamily="Consolas" FontSize="12"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusRight" Grid.Column="2" Foreground="#7a7a7a"
                       Padding="6,3,8,3" FontFamily="Consolas" FontSize="12" />
        </Grid>

        <Grid x:Name="TabArea" />

    </DockPanel>
</Window>
